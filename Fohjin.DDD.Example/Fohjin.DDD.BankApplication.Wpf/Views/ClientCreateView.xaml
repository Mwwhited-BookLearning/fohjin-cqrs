<UserControl x:Class="Fohjin.DDD.BankApplication.Wpf.Views.ClientCreateView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Fohjin.DDD.BankApplication.Wpf.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:ClientCreateViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008/design"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <StackPanel Margin="16" MaxWidth="400" HorizontalAlignment="Left">
        <TextBlock Text="New client" Style="{StaticResource HeaderText}" />

        <TextBlock Text="Name" />
        <TextBox Text="{Binding ClientName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="_clientName" />
        <TextBlock Text="Street" />
        <TextBox Text="{Binding Street, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="_street" />
        <TextBlock Text="Street number" />
        <TextBox Text="{Binding StreetNumber, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="_streetNumber" />
        <TextBlock Text="Postal code" />
        <TextBox Text="{Binding PostalCode, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="_postalCode" />
        <TextBlock Text="City" />
        <TextBox Text="{Binding City, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="_city" />
        <TextBlock Text="Phone number" />
        <TextBox Text="{Binding PhoneNumber, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="_phoneNumber" />

        <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource ErrorText}"
                   Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibilityConverter}}" />

        <StackPanel Orientation="Horizontal">
            <Button Content="Create client" Command="{Binding SubmitCommand}" IsEnabled="{Binding Submitting, Converter={StaticResource InverseBooleanConverter}}" AutomationProperties.AutomationId="_createClientButton" />
            <Button Content="Cancel" Command="{Binding CancelCommand}" AutomationProperties.AutomationId="_cancelButton" />
        </StackPanel>
    </StackPanel>
</UserControl>
