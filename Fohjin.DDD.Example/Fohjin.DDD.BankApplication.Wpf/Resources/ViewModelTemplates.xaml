<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:Fohjin.DDD.BankApplication.Wpf.ViewModels"
                    xmlns:views="clr-namespace:Fohjin.DDD.BankApplication.Wpf.Views">

    <!-- Structure layer (docs/patterns/wpf-architecture.md): maps each ViewModel type to the
         View that renders it. Navigation (Services/NavigationService.cs) only ever sets
         CurrentViewModel - it never constructs a View directly; these templates are what
         actually pick the matching View. -->

    <DataTemplate DataType="{x:Type vm:ClientSearchViewModel}">
        <views:ClientSearchView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:ClientCreateViewModel}">
        <views:ClientCreateView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:ClientDetailsViewModel}">
        <views:ClientDetailsView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:AccountDetailsViewModel}">
        <views:AccountDetailsView />
    </DataTemplate>

</ResourceDictionary>
