<Window x:Class="Fohjin.DDD.BankApplication.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Fohjin.DDD.BankApplication.Wpf"
        mc:Ignorable="d"
        Title="Fohjin Bank" Height="600" Width="620">
    <!-- DataContext is the INavigationService itself (App.xaml.cs) - CurrentViewModel changing
         is all this window needs to know about; Resources/ViewModelTemplates.xaml picks which
         View actually renders for whatever ViewModel type CurrentViewModel currently is. -->
    <ContentControl Content="{Binding CurrentViewModel}" />
</Window>
