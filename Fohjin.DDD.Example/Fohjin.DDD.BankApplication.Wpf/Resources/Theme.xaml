<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="clr-namespace:Fohjin.DDD.BankApplication.Wpf.Converters">

    <!-- Shared design tokens (docs/patterns/wpf-architecture.md's Styling layer) - the direct
         WPF equivalent of Fohjin.DDD.WebUI/src/theme/tokens.css. A View should reference these
         via StaticResource rather than hard-coding a color/spacing value. -->

    <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    <conv:BoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" Invert="True" />
    <conv:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
    <conv:InverseBooleanConverter x:Key="InverseBooleanConverter" />

    <SolidColorBrush x:Key="BorderBrush" Color="#EEEEEE" />
    <SolidColorBrush x:Key="HoverBrush" Color="#F5F5F5" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#D4EDDA" />
    <SolidColorBrush x:Key="SuccessTextBrush" Color="#155724" />
    <SolidColorBrush x:Key="DangerBrush" Color="#C0392B" />
    <SolidColorBrush x:Key="DangerBgBrush" Color="#F8D7DA" />
    <SolidColorBrush x:Key="DangerTextBrush" Color="#721C24" />
    <SolidColorBrush x:Key="MutedBrush" Color="#EEEEEE" />
    <SolidColorBrush x:Key="ErrorTextBrush" Color="#C0392B" />

    <Thickness x:Key="SpacingXs">4</Thickness>
    <Thickness x:Key="SpacingSm">8</Thickness>
    <Thickness x:Key="SpacingMd">12</Thickness>
    <Thickness x:Key="SpacingLg">16</Thickness>

    <Style TargetType="TextBlock" x:Key="HeaderText">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>

    <Style TargetType="TextBlock" x:Key="SectionHeaderText">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,0,0,6" />
    </Style>

    <Style TargetType="TextBlock" x:Key="ErrorText">
        <Setter Property="Foreground" Value="{StaticResource ErrorTextBrush}" />
        <Setter Property="Margin" Value="0,4,0,4" />
    </Style>

    <Style TargetType="Button" x:Key="DangerButton">
        <Setter Property="Background" Value="{StaticResource DangerBrush}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Padding" Value="12,6" />
    </Style>

    <Style TargetType="GroupBox">
        <Setter Property="Margin" Value="0,0,0,12" />
        <Setter Property="Padding" Value="8" />
    </Style>

    <Style TargetType="TextBox">
        <Setter Property="Margin" Value="0,2,0,8" />
    </Style>

    <Style TargetType="Button">
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="Margin" Value="0,4,8,0" />
    </Style>

</ResourceDictionary>
