<UserControl x:Class="Fohjin.DDD.BankApplication.Wpf.Views.ClientDetailsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Fohjin.DDD.BankApplication.Wpf.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:ClientDetailsViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008/design"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16" MaxWidth="480" HorizontalAlignment="Left">
            <TextBlock Text="{Binding ClientName}" Style="{StaticResource HeaderText}"
                       Visibility="{Binding IsLoading, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
            <TextBlock Text="Loading..." Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}" />
            <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource ErrorText}"
                       Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibilityConverter}}" />

            <GroupBox Header="Name">
                <StackPanel>
                    <TextBox Text="{Binding ClientName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="_clientName" />
                    <Button Content="Save name" Command="{Binding SaveNameCommand}" HorizontalAlignment="Left" AutomationProperties.AutomationId="_saveNameButton" />
                </StackPanel>
            </GroupBox>

            <GroupBox Header="Address">
                <StackPanel>
                    <TextBlock Text="Street" /><TextBox Text="{Binding Street, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="_street" />
                    <TextBlock Text="Street number" /><TextBox Text="{Binding StreetNumber, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="_streetNumber" />
                    <TextBlock Text="Postal code" /><TextBox Text="{Binding PostalCode, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="_postalCode" />
                    <TextBlock Text="City" /><TextBox Text="{Binding City, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="_city" />
                    <Button Content="Save address" Command="{Binding SaveAddressCommand}" HorizontalAlignment="Left" AutomationProperties.AutomationId="_saveAddressButton" />
                </StackPanel>
            </GroupBox>

            <GroupBox Header="Phone number">
                <StackPanel>
                    <TextBox Text="{Binding PhoneNumber, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="_phoneNumber" />
                    <Button Content="Save phone number" Command="{Binding SavePhoneNumberCommand}" HorizontalAlignment="Left" AutomationProperties.AutomationId="_savePhoneNumberButton" />
                </StackPanel>
            </GroupBox>

            <GroupBox Header="Accounts">
                <StackPanel>
                    <!-- ListBox.InputBindings + MouseBinding LeftDoubleClick never fires here -
                         ListBoxItem's own MouseLeftButtonDown handling (selection) consumes the
                         click before the ListBox's InputBindings gesture recognition sees it
                         (confirmed live driving the ClientSearchView equivalent of this same
                         pattern: zero command invocations despite selection working fine). An
                         ItemContainerStyle EventSetter attaches MouseDoubleClick directly to each
                         ListBoxItem instead, which does fire reliably since the item is the
                         actual event source, not a bubbled-past ancestor. -->
                    <ListBox ItemsSource="{Binding Accounts}" MaxHeight="120" SelectedItem="{Binding SelectedAccount}" AutomationProperties.AutomationId="_accounts">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <EventSetter Event="MouseDoubleClick" Handler="AccountItem_MouseDoubleClick" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                    <TextBlock Text="Closed accounts" Style="{StaticResource SectionHeaderText}" Margin="0,8,0,0" />
                    <ListBox ItemsSource="{Binding ClosedAccounts}" MaxHeight="80" AutomationProperties.AutomationId="_closedAccounts" />
                    <TextBlock Text="New account name" Margin="0,8,0,0" />
                    <TextBox Text="{Binding NewAccountName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="_newAccountName" />
                    <Button Content="Open account" Command="{Binding OpenNewAccountCommand}" HorizontalAlignment="Left" AutomationProperties.AutomationId="_openAccountButton" />
                </StackPanel>
            </GroupBox>

            <GroupBox Header="Bank cards">
                <StackPanel>
                    <ListBox ItemsSource="{Binding BankCards}" MaxHeight="120" SelectedItem="{Binding SelectedBankCard}" AutomationProperties.AutomationId="_bankCards" />
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,8">
                        <Button Content="Cancel"
                                Command="{Binding CancelBankCardCommand}"
                                CommandParameter="{Binding SelectedBankCard}"
                                AutomationProperties.AutomationId="_cancelBankCardButton" />
                        <Button Content="Report stolen"
                                Command="{Binding ReportBankCardStolenCommand}"
                                CommandParameter="{Binding SelectedBankCard}"
                                AutomationProperties.AutomationId="_reportBankCardStolenButton" />
                    </StackPanel>
                    <TextBlock Text="Assign a new bank card to an account" Style="{StaticResource SectionHeaderText}" />
                    <ComboBox ItemsSource="{Binding Accounts}" SelectedItem="{Binding SelectedNewBankCardAccount}" AutomationProperties.AutomationId="_newBankCardAccount" />
                    <Button Content="Assign" Command="{Binding AssignNewBankCardCommand}" HorizontalAlignment="Left" IsEnabled="{Binding AssigningBankCard, Converter={StaticResource InverseBooleanConverter}}" AutomationProperties.AutomationId="_assignBankCardButton" />
                </StackPanel>
            </GroupBox>
        </StackPanel>
    </ScrollViewer>
</UserControl>
