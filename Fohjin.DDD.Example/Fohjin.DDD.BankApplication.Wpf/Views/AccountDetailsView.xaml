<UserControl x:Class="Fohjin.DDD.BankApplication.Wpf.Views.AccountDetailsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Fohjin.DDD.BankApplication.Wpf.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:AccountDetailsViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008/design"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16" MaxWidth="480" HorizontalAlignment="Left">
            <TextBlock Text="{Binding AccountName}" Style="{StaticResource HeaderText}"
                       Visibility="{Binding IsLoading, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
            <TextBlock Text="Loading..." Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}" />
            <TextBlock Visibility="{Binding IsLoading, Converter={StaticResource InverseBoolToVisibilityConverter}}" AutomationProperties.AutomationId="_accountSummary">
                <Run Text="Account number:" /><Run Text="{Binding AccountNumber, Mode=OneWay}" />
                <Run Text=" &#183; Balance:" /><Run Text="{Binding Balance, Mode=OneWay}" />
            </TextBlock>
            <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource ErrorText}"
                       Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibilityConverter}}" />

            <GroupBox Header="Name">
                <StackPanel>
                    <TextBox Text="{Binding AccountName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="_accountName" />
                    <Button Content="Save name" Command="{Binding SaveNameCommand}" HorizontalAlignment="Left" AutomationProperties.AutomationId="_saveNameButton" />
                </StackPanel>
            </GroupBox>

            <GroupBox Header="Deposit">
                <StackPanel>
                    <TextBox Text="{Binding DepositAmount, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="_depositAmount" />
                    <Button Content="Deposit" Command="{Binding DepositCommand}" HorizontalAlignment="Left" AutomationProperties.AutomationId="_depositButton" />
                </StackPanel>
            </GroupBox>

            <GroupBox Header="Withdrawal">
                <StackPanel>
                    <TextBox Text="{Binding WithdrawalAmount, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="_withdrawalAmount" />
                    <Button Content="Withdraw" Command="{Binding WithdrawCommand}" HorizontalAlignment="Left" AutomationProperties.AutomationId="_withdrawButton" />
                </StackPanel>
            </GroupBox>

            <GroupBox Header="Transfer">
                <StackPanel>
                    <TextBlock Text="Amount" /><TextBox Text="{Binding TransferAmount, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="_transferAmount" />
                    <TextBlock Text="To account" />
                    <ComboBox ItemsSource="{Binding OtherAccounts}" SelectedItem="{Binding TransferTargetAccount}" AutomationProperties.AutomationId="_transferTargetAccount" />
                    <Button Content="Transfer" Command="{Binding TransferCommand}" HorizontalAlignment="Left" AutomationProperties.AutomationId="_transferButton" />
                </StackPanel>
            </GroupBox>

            <GroupBox Header="Transaction history">
                <ListBox ItemsSource="{Binding Ledgers}" MaxHeight="140" AutomationProperties.AutomationId="_ledgers" />
            </GroupBox>

            <Button Content="Close account" Command="{Binding CloseAccountCommand}" Style="{StaticResource DangerButton}" HorizontalAlignment="Left" AutomationProperties.AutomationId="_closeAccountButton" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
